# Real inventory (laptop hostname/user): never version it
ansible/inventory/*
!ansible/inventory/inventory.example.yaml
!ansible/inventory/ci.yaml

# Decrypted secrets and keys
*.dec.yaml
*.decrypted.*
keys.txt
*.agekey

# Kubeconfigs (contain the tailnet name and credentials)
kubeconfig
kubeconfig*.yaml
kubeconfig*.yml
*.kubeconfig

# OpenTofu: the (encrypted) terraform.tfstate is versioned; providers and plans are not
.terraform/
*.tfstate.backup
*.tfplan

# Tools
.venv/
.cache/
*.retry
