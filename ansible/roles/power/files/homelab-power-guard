#!/bin/sh
# Managed by Ansible (homelab), role power. See ADR 012.
#
# Power guard of the laptop servers:
#   (default)     checks the power every 30 s; on battery with charge <= limit, it arms the
#                 RTC to power back on and shuts the machine down.
#   --once        a single check (tests).
#   --boot-gate   at boot, if the last shutdown was caused by the battery (marker), decides
#                 whether the boot goes on or shuts down again before k3s/samba start.
#   --dry-run     only prints what it would do.
# HOMELAB_POWER_* variables override paths and limits (tests with a fake sysfs).
set -eu

SYSFS=${HOMELAB_POWER_SYSFS:-/sys/class/power_supply}
RTC=${HOMELAB_POWER_RTC:-/sys/class/rtc/rtc0/wakealarm}
STATE_DIR=${HOMELAB_POWER_STATE:-/var/lib/homelab-power}
SHUTDOWN_PERCENT=${HOMELAB_POWER_SHUTDOWN_PERCENT:-10}
WAKE_INTERVAL=${HOMELAB_POWER_WAKE_INTERVAL:-1800}
INTERVAL=${HOMELAB_POWER_INTERVAL:-30}
# At boot, only a battery with headroom above the shutdown limit lets the boot go on.
GATE_MARGIN=5
MARKER=$STATE_DIR/rtc-armed

mode=watch
dry_run=0
for arg in "$@"; do
  case $arg in
    --once) mode=once ;;
    --boot-gate) mode=gate ;;
    --dry-run) dry_run=1 ;;
    *)
      echo "usage: $0 [--once|--boot-gate] [--dry-run]" >&2
      exit 2
      ;;
  esac
done

log() {
  if [ "$dry_run" = 1 ]; then echo "homelab-power: $*"; else logger -t homelab-power -- "$*"; fi
}

run() {
  if [ "$dry_run" = 1 ]; then echo "dry-run: $*"; else "$@"; fi
}

# ac_online: 1 (on AC), 0 (on battery) or empty (no Mains supply: CI, desktop).
# capacity: lowest charge among the batteries, empty if there is no battery.
read_power() {
  ac_online=""
  capacity=""
  for dev in "$SYSFS"/*; do
    [ -r "$dev/type" ] || continue
    case $(cat "$dev/type") in
      Mains)
        if [ "$(cat "$dev/online" 2>/dev/null || echo 0)" = 1 ]; then ac_online=1; else ac_online=${ac_online:-0}; fi
        ;;
      Battery)
        cap=$(cat "$dev/capacity" 2>/dev/null || true)
        if [ -n "$cap" ] && { [ -z "$capacity" ] || [ "$cap" -lt "$capacity" ]; }; then capacity=$cap; fi
        ;;
    esac
  done
}

arm_rtc() {
  if [ "$WAKE_INTERVAL" -gt 0 ] && [ -w "$RTC" ]; then
    run sh -c "echo 0 > '$RTC' && echo +$WAKE_INTERVAL > '$RTC'"
    run mkdir -p "$STATE_DIR"
    run touch "$MARKER"
    log "RTC armed: powers back on in ${WAKE_INTERVAL}s to check the power"
  fi
}

power_off() {
  arm_rtc
  run systemctl --no-block poweroff
}

check_once() {
  read_power
  if [ -z "$ac_online" ] || [ -z "$capacity" ]; then
    return 0
  fi
  if [ "$ac_online" = 1 ]; then
    if [ "$on_battery" = 1 ]; then
      log "external power restored: ${capacity}%"
      on_battery=0
    fi
    return 0
  fi
  if [ "$on_battery" = 0 ]; then
    log "external power lost: ${capacity}% (shuts down at ${SHUTDOWN_PERCENT}%)"
    on_battery=1
  fi
  if [ "$capacity" -le "$SHUTDOWN_PERCENT" ]; then
    log "shutting down at ${capacity}% battery"
    power_off
    return 1
  fi
}

boot_gate() {
  [ -e "$MARKER" ] || return 0
  # The battery driver can show up after udev; wait up to 20 s.
  tries=0
  read_power
  while { [ -z "$ac_online" ] || [ -z "$capacity" ]; } && [ "$tries" -lt 20 ]; do
    sleep 1
    tries=$((tries + 1))
    read_power
  done

  # Only shut down again on a reliable low-battery reading. Without a reading (broken driver,
  # new kernel), go on: an endless boot loop would leave the machine unreachable.
  if [ "$ac_online" = 0 ] && [ -n "$capacity" ] &&
    [ "$capacity" -le $((SHUTDOWN_PERCENT + GATE_MARGIN)) ]; then
    log "RTC boot still on battery at ${capacity}%: shutting down again"
    power_off
    return 0
  fi
  if [ "$ac_online" = 1 ]; then
    log "RTC boot with the power back (${capacity:-?}%): going on"
  elif [ "$ac_online" = 0 ] && [ -n "$capacity" ]; then
    log "RTC boot on battery at ${capacity}%, above the margin: going on, the guard takes over"
  else
    log "RTC boot without a safe decision (power=${ac_online:-?}, battery=${capacity:-?}%): going on, the guard takes over"
  fi
  run rm -f "$MARKER"
}

if [ "$mode" = gate ]; then
  boot_gate
  exit 0
fi

on_battery=0
if [ "$mode" = once ]; then
  check_once || true
  exit 0
fi
while check_once; do
  sleep "$INTERVAL"
done
# Shutdown requested: wait for systemd to stop the service.
sleep infinity
