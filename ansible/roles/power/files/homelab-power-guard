#!/bin/sh
# Gerenciado pelo Ansible (2026-kubernetes), role power. Veja o ADR 012.
#
# Guardião de energia dos notebooks-servidor:
#   (padrão)      confere a energia a cada 30 s; na bateria com carga <= limite, arma o
#                 RTC para religar e desliga a máquina.
#   --once        uma conferência só (testes).
#   --boot-gate   no boot, se o último desligamento foi pela bateria (marcador), decide
#                 se o boot segue ou se desliga de novo antes do k3s/samba subirem.
#   --dry-run     só imprime o que faria.
# Variáveis HOMELAB_POWER_* trocam caminhos e limites (testes com sysfs falso).
set -eu

SYSFS=${HOMELAB_POWER_SYSFS:-/sys/class/power_supply}
RTC=${HOMELAB_POWER_RTC:-/sys/class/rtc/rtc0/wakealarm}
STATE_DIR=${HOMELAB_POWER_STATE:-/var/lib/homelab-power}
SHUTDOWN_PERCENT=${HOMELAB_POWER_SHUTDOWN_PERCENT:-10}
WAKE_INTERVAL=${HOMELAB_POWER_WAKE_INTERVAL:-1800}
INTERVAL=${HOMELAB_POWER_INTERVAL:-30}
# No boot, só segue na bateria quem tem folga acima do limite de desligamento.
GATE_MARGIN=5
MARKER=$STATE_DIR/rtc-armed

mode=watch
dry_run=0
for arg in "$@"; do
  case $arg in
    --once) mode=once ;;
    --boot-gate) mode=gate ;;
    --dry-run) dry_run=1 ;;
    *)
      echo "uso: $0 [--once|--boot-gate] [--dry-run]" >&2
      exit 2
      ;;
  esac
done

log() {
  if [ "$dry_run" = 1 ]; then echo "homelab-power: $*"; else logger -t homelab-power -- "$*"; fi
}

run() {
  if [ "$dry_run" = 1 ]; then echo "dry-run: $*"; else "$@"; fi
}

# ac_online: 1 (na tomada), 0 (na bateria) ou vazio (sem fonte Mains: CI, desktop).
# capacity: menor carga entre as baterias, vazio se não há bateria.
read_power() {
  ac_online=""
  capacity=""
  for dev in "$SYSFS"/*; do
    [ -r "$dev/type" ] || continue
    case $(cat "$dev/type") in
      Mains)
        if [ "$(cat "$dev/online" 2>/dev/null || echo 0)" = 1 ]; then ac_online=1; else ac_online=${ac_online:-0}; fi
        ;;
      Battery)
        cap=$(cat "$dev/capacity" 2>/dev/null || true)
        if [ -n "$cap" ] && { [ -z "$capacity" ] || [ "$cap" -lt "$capacity" ]; }; then capacity=$cap; fi
        ;;
    esac
  done
}

arm_rtc() {
  if [ "$WAKE_INTERVAL" -gt 0 ] && [ -w "$RTC" ]; then
    run sh -c "echo 0 > '$RTC' && echo +$WAKE_INTERVAL > '$RTC'"
    run mkdir -p "$STATE_DIR"
    run touch "$MARKER"
    log "RTC armado: religa em ${WAKE_INTERVAL}s para conferir a energia"
  fi
}

power_off() {
  arm_rtc
  run systemctl --no-block poweroff
}

check_once() {
  read_power
  if [ -z "$ac_online" ] || [ -z "$capacity" ]; then
    return 0
  fi
  if [ "$ac_online" = 1 ]; then
    if [ "$on_battery" = 1 ]; then
      log "energia externa voltou: ${capacity}%"
      on_battery=0
    fi
    return 0
  fi
  if [ "$on_battery" = 0 ]; then
    log "energia externa caiu: ${capacity}% (desliga com ${SHUTDOWN_PERCENT}%)"
    on_battery=1
  fi
  if [ "$capacity" -le "$SHUTDOWN_PERCENT" ]; then
    log "desligando com ${capacity}% de bateria"
    power_off
    return 1
  fi
}

boot_gate() {
  [ -e "$MARKER" ] || return 0
  # O driver da bateria pode aparecer depois do udev; espera até 20 s.
  tries=0
  read_power
  while { [ -z "$ac_online" ] || [ -z "$capacity" ]; } && [ "$tries" -lt 20 ]; do
    sleep 1
    tries=$((tries + 1))
    read_power
  done

  # Só desliga de novo com leitura certa de bateria baixa. Sem leitura (driver quebrado,
  # kernel novo), segue: um ciclo infinito de boots deixaria a máquina inacessível.
  if [ "$ac_online" = 0 ] && [ -n "$capacity" ] &&
    [ "$capacity" -le $((SHUTDOWN_PERCENT + GATE_MARGIN)) ]; then
    log "boot pelo RTC ainda na bateria com ${capacity}%: desligando de novo"
    power_off
    return 0
  fi
  if [ "$ac_online" = 1 ]; then
    log "boot pelo RTC com a energia de volta (${capacity:-?}%): seguindo"
  elif [ "$ac_online" = 0 ] && [ -n "$capacity" ]; then
    log "boot pelo RTC na bateria com ${capacity}%, acima da margem: seguindo, o guardião assume"
  else
    log "boot pelo RTC sem decisão segura (energia=${ac_online:-?}, bateria=${capacity:-?}%): seguindo, o guardião assume"
  fi
  run rm -f "$MARKER"
}

if [ "$mode" = gate ]; then
  boot_gate
  exit 0
fi

on_battery=0
if [ "$mode" = once ]; then
  check_once || true
  exit 0
fi
while check_once; do
  sleep "$INTERVAL"
done
# Desligamento pedido: espera o systemd parar o serviço.
sleep infinity
