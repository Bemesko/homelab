# Managed by Ansible (homelab), role power. See ADR 012.
[Unit]
Description=Power guard: shuts down on low battery and arms the RTC
After=local-fs.target

[Service]
Type=simple
Environment=HOMELAB_POWER_SHUTDOWN_PERCENT={{ power_shutdown_percent }}
Environment=HOMELAB_POWER_WAKE_INTERVAL={{ power_rtc_wake_interval }}
ExecStart=/usr/local/sbin/homelab-power-guard
Restart=always
RestartSec=10
Nice=-5

[Install]
WantedBy=multi-user.target
