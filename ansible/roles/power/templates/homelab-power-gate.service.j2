# Managed by Ansible (homelab), role power. See ADR 012.
# Only acts when the last shutdown came from the guard (marker in /var/lib/homelab-power):
# if power is not back, shuts down again before the network, k3s and samba start.
[Unit]
Description=Check the power at boot after a low-battery shutdown
DefaultDependencies=no
After=local-fs.target systemd-udev-trigger.service
Before=network-pre.target k3s.service smbd.service shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
Environment=HOMELAB_POWER_SHUTDOWN_PERCENT={{ power_shutdown_percent }}
Environment=HOMELAB_POWER_WAKE_INTERVAL={{ power_rtc_wake_interval }}
ExecStart=/usr/local/sbin/homelab-power-guard --boot-gate
RemainAfterExit=true

[Install]
WantedBy=multi-user.target
