# Managed by Ansible (homelab, role host_network, ADR 017). Local edits are overwritten.
# Netplan merges this with the installer's profile for the same ID: it only turns DHCP on for the wired port.
network:
  version: 2
  ethernets:
    {{ host_network_netplan_id }}:
      dhcp4: true
      dhcp6: true
