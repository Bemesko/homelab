profile: production
offline: true
exclude_paths:
  - .github/
  - kubernetes/
  - .cache/
  - .claude/ # local Claude Code session worktrees (outside git)
  - ansible/secrets/*.sops.yaml # generated by sops; validated by the sops-encrypted hook
kinds:
  - playbook: "ansible/*.yaml"
  - vars: "ansible/group_vars/**/*.yaml"
  - yaml: "ansible/inventory/*.yaml"
